// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    Int      @default(1)
  vivariums Vivarium[]
  commands  Command[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model Vivarium {
  id          Int        @id @default(autoincrement())
  name        String
  location    String?
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  sensors     Sensor[]
  commands    Command[]
  deviceId    String?    @unique // ID unique de l'ESP32
  isOnline    Boolean    @default(false)
  lastSeen    DateTime?
}

model measurement {
  id Int @id @default(autoincrement())
  vivariumId Int
  bucketUuid String
  createdAt DateTime @default(now())
}

model Sensor {
  id          Int      @id @default(autoincrement())
  name        String
  type        SensorType
  unit        String?
  minValue    Float?
  maxValue    Float?
  vivariumId  Int
  vivarium    Vivarium @relation(fields: [vivariumId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Command {
  id          Int           @id @default(autoincrement())
  type        CommandType
  payload     Json          // Données spécifiques à la commande
  status      CommandStatus @default(PENDING)
  vivariumId  Int
  vivarium    Vivarium      @relation(fields: [vivariumId], references: [id], onDelete: Cascade)
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now())
  executedAt  DateTime?
  errorMessage String?
}

enum SensorType {
  TEMPERATURE
  HUMIDITY
  LIGHT
  WATER_LEVEL
  PH_LEVEL
  CO2_LEVEL
  MOTION
  PRESSURE
  CUSTOM
}

enum CommandType {
  PUMP_ON
  PUMP_OFF
  LIGHT_ON
  LIGHT_OFF
  HEATER_ON
  HEATER_OFF
  FAN_ON
  FAN_OFF
  FEEDING
  WATER_CHANGE
  CUSTOM
}

enum CommandStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  CANCELLED
}

